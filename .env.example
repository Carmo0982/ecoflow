# EcoFlow · variables del cliente (Vite). Copia como .env.local.
# Todo lo que empieza por VITE_ queda en el JavaScript público: solo valores públicos.
# NUNCA pongas aquí la service_role key (salta todas las políticas RLS).
# Sin estas variables la app arranca en modo demo con datos locales.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co

# Clave pública anon / publishable
VITE_SUPABASE_ANON_KEY=<tu-anon-key>
